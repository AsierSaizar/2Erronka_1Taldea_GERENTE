<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import javafx.collections.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="768.0" prefWidth="1320.0" style="-fx-background-color: #F8F8F8;" styleClass="tableBackColor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gerenteapp.LangileaController">
    <children>
        <!-- Navbar -->
        <HBox fx:id="navBarContainer" prefHeight="74.0" prefWidth="1063.0" styleClass="navBar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

        <!-- Título -->
        <Label layoutX="122.0" layoutY="92.0" prefHeight="34.0" prefWidth="103.0" text="Langileak">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <!-- Tabla de Langileak -->
        <TableView fx:id="langileakTable" layoutX="320.0" layoutY="137.0" maxHeight="300.0" maxWidth="880.0" prefHeight="300.0" prefWidth="877.0" AnchorPane.leftAnchor="320.0">
            <columns>
                <TableColumn fx:id="idColumn" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="izenaColumn" maxWidth="150.0" minWidth="75.0" prefWidth="100.0" text="Izena" />
                <TableColumn fx:id="abizenaColumn" maxWidth="150.0" minWidth="75.0" prefWidth="100.0" text="Abizena" />
                <TableColumn fx:id="emailColumn" maxWidth="250.0" minWidth="150.0" prefWidth="200.0" text="Emaila" />
                <TableColumn fx:id="pasahitzaColumn" maxWidth="250.0" minWidth="150.0" prefWidth="200.0" text="Pasahitza" />
                <TableColumn fx:id="nivelPermisosColumn" maxWidth="100.0" minWidth="75.0" prefWidth="100.0" text="Nivel Permisos" />
                <TableColumn fx:id="deleted_atColumn" maxWidth="128.79998779296875" minWidth="75.0" prefWidth="125.5999755859375" text="Deleted at" />
                <TableColumn fx:id="txatPermisosColumn" maxWidth="100.0" minWidth="75.0" prefWidth="100.0" text="Txat baimena" />
            </columns>
        </TableView>

        <!-- Crear nuevo langilea -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#091725" height="233.0" layoutX="101.0" layoutY="509.0" stroke="BLACK" strokeType="INSIDE" width="383.0" />
        <Label layoutX="213.0" layoutY="513.0" prefHeight="56.0" prefWidth="160.0" text="Gehitu langilea" textFill="WHITE">
            <font>
                <Font size="23.0" />
            </font>
        </Label>
        <TextField fx:id="izenaField" layoutX="129.0" layoutY="581.0" promptText="Izena" />
        <TextField fx:id="abizenaField" layoutX="300.0" layoutY="582.0" promptText="Abizena" />
        <TextField fx:id="emailaField" layoutX="129.0" layoutY="617.0" promptText="Emaila" />
        <TextField fx:id="pasahitzaField" layoutX="300.0" layoutY="617.0" promptText="Pasahitza" />
        <ComboBox fx:id="nivelPermisosComboBox" editable="false" layoutX="128.0" layoutY="657.0" prefWidth="150.0" promptText="Nivel de permisos">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <Integer fx:value="0" />
                    <Integer fx:value="1" />
                    <Integer fx:value="2" />
                </FXCollections>
            </items>
        </ComboBox>
        <ComboBox fx:id="txatPermisosComboBox" editable="false" layoutX="300.0" layoutY="655.0" prefWidth="150.0" promptText="Txat baimena">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <Integer fx:value="0" />
                    <Integer fx:value="1" />
                </FXCollections>
            </items>
        </ComboBox>

        <Button fx:id="btnSortu" layoutX="218.0" layoutY="702.0" mnemonicParsing="false" onAction="#createLangilea" prefHeight="26.0" prefWidth="150.0" styleClass="buttonCss" text="Sortu" />

        <!-- Editar langilea -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#091725" height="233.0" layoutX="576.0" layoutY="508.0" stroke="BLACK" strokeType="INSIDE" width="383.0" />
        <Label layoutX="683.0" layoutY="511.0" prefHeight="56.0" prefWidth="170.0" text="Eraldatu langilea" textFill="WHITE">
            <font>
                <Font size="23.0" />
            </font>
        </Label>
        <TextField fx:id="izenaEditField" layoutX="609.0" layoutY="580.0" promptText="Izena" />
        <TextField fx:id="abizenaEditField" layoutX="780.0" layoutY="581.0" promptText="Abizena" />
        <TextField fx:id="emailaEditField" layoutX="609.0" layoutY="616.0" promptText="Emaila" />
        <TextField fx:id="pasahitzaEditField" layoutX="780.0" layoutY="616.0" promptText="Pasahitza" />
        <ComboBox fx:id="nivelPermisosComboBoxEdit" editable="false" layoutX="608.0" layoutY="655.0" prefWidth="150.0" promptText="Nivel de permisos">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <Integer fx:value="0" />
                    <Integer fx:value="1" />
                    <Integer fx:value="2" />
                </FXCollections>
            </items>
        </ComboBox>
        <ComboBox fx:id="txatPermisosEditComboBox" editable="false" layoutX="780.0" layoutY="655.0" prefWidth="150.0" promptText="Txat baimena">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <Integer fx:value="0" />
                    <Integer fx:value="1" />
                </FXCollections>
            </items>
        </ComboBox>
        <TextField fx:id="deleted_atEditField" editable="false" layoutX="1143.0" layoutY="652.0" prefHeight="26.0" prefWidth="131.0" promptText="Deleted at" />
        <Button layoutX="692.0" layoutY="702.0" mnemonicParsing="false" onAction="#editLangilea" prefHeight="26.0" prefWidth="150.0" styleClass="buttonCss" text="Eraldatu" />
        <!-- Eliminar langilea -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#091725" height="233.0" layoutX="1046.0" layoutY="513.0" stroke="BLACK" strokeType="INSIDE" width="383.0" />
        <Label layoutX="1152.0" layoutY="552.0" prefHeight="56.0" prefWidth="176.0" text="Ezabatu langilea" textFill="WHITE">
            <font>
                <Font size="23.0" />
            </font>
        </Label>
        <TextField fx:id="izenaDeleteField" editable="false" layoutX="1218.0" layoutY="616.0" prefHeight="26.0" prefWidth="131.0" promptText="Izena" />
        <TextField fx:id="IdDeleteField" editable="false" layoutX="1143.0" layoutY="617.0" prefHeight="26.0" prefWidth="63.0" promptText="ID" />
        <Button layoutX="1134.0" layoutY="661.0" mnemonicParsing="false" onAction="#deleteLangilea" prefHeight="34.0" prefWidth="103.0" styleClass="buttonCss" text="Ezabatu" />
        <Button layoutX="1247.0" layoutY="661.0" mnemonicParsing="false" onAction="#berreskuratuLangilea" prefHeight="34.0" prefWidth="103.0" styleClass="buttonCss" text="Berreskuratu" />
    </children>

    <stylesheets>
        <URL value="@../../../css/navbar.css" />
        <URL value="@../../../css/header.css" />
    </stylesheets>
</AnchorPane>
